@host = http://localhost:5080

# Seeded identities (see src/Kelvinvale.Core/Persistence/SeedIds.cs)
@adviser1 = 3f9c1b4e-7d21-4a55-9b02-1c6e8ad47f10
@adviser2 = a1d2c3b4-5e6f-4a7b-8c9d-0e1f2a3b4c5d
@customer1 = 11111111-1111-4111-8111-111111111111
@customer2 = 22222222-2222-4222-8222-222222222222
@customer3 = 33333333-3333-4333-8333-333333333333
@customer4minor = 44444444-4444-4444-8444-444444444444
@customer1Isa = a5a5a5a1-0000-4000-8000-000000000001
@customer1Gia = a5a5a5a1-0000-4000-8000-000000000002
@customer3Isa = a5a5a5a3-0000-4000-8000-000000000001

### Health (anonymous)
GET {{host}}/health

### Unauthenticated -> 401
GET {{host}}/api/v1/customers/{{customer1}}/products

### Adviser 1 views a customer they look after -> 200
GET {{host}}/api/v1/customers/{{customer1}}
X-Caller-Id: {{adviser1}}
X-Caller-Role: Adviser

### Customer 2 reaches Customer 1's ISA -> 404 (not yours)
GET {{host}}/api/v1/products/{{customer1Isa}}
X-Caller-Id: {{customer2}}
X-Caller-Role: Customer

### Customer 2 tries to move Customer 1's money -> 404
POST {{host}}/api/v1/products/{{customer1Isa}}/instructions
X-Caller-Id: {{customer2}}
X-Caller-Role: Customer
Content-Type: application/json

{ "type": "Subscription", "amountPence": 100000, "fundCode": "GLB-EQ-ACC", "clientReference": "probe-0001" }

### Customer tries to open a product -> 403 (role)
POST {{host}}/api/v1/customers/{{customer1}}/products
X-Caller-Id: {{customer1}}
X-Caller-Role: Customer
Content-Type: application/json

{ "type": "Gia" }

### Adviser 1 opens a SIPP for an adult customer -> 201
POST {{host}}/api/v1/customers/{{customer1}}/products
X-Caller-Id: {{adviser1}}
X-Caller-Role: Adviser
Content-Type: application/json

{ "type": "Sipp" }

### Adviser 2 opens a SIPP for a 16-year-old -> 422 sipp.minimum-age
POST {{host}}/api/v1/customers/{{customer4minor}}/products
X-Caller-Id: {{adviser2}}
X-Caller-Role: Adviser
Content-Type: application/json

{ "type": "Sipp" }

### Customer 3 subscribes past the ISA allowance (19,500 of 20,000 used) -> 422 isa.allowance-exceeded
POST {{host}}/api/v1/products/{{customer3Isa}}/instructions
X-Caller-Id: {{customer3}}
X-Caller-Role: Customer
Content-Type: application/json

{ "type": "Subscription", "amountPence": 60000, "fundCode": "GLB-EQ-ACC", "clientReference": "c3-2026-0001" }

### Customer 3 subscribes exactly the remaining 500 -> 201
POST {{host}}/api/v1/products/{{customer3Isa}}/instructions
X-Caller-Id: {{customer3}}
X-Caller-Role: Customer
Content-Type: application/json

{ "type": "Subscription", "amountPence": 50000, "fundCode": "GLB-EQ-ACC", "clientReference": "c3-2026-0002" }

### Customer 1 places an instruction on their own GIA -> 201 (reportable = true)
POST {{host}}/api/v1/products/{{customer1Gia}}/instructions
X-Caller-Id: {{customer1}}
X-Caller-Role: Customer
Content-Type: application/json

{ "type": "Subscription", "amountPence": 250000, "fundCode": "GLB-EQ-ACC", "clientReference": "c1-gia-0001" }

### Customer 1 updates their own details -> 200
PUT {{host}}/api/v1/customers/{{customer1}}
X-Caller-Id: {{customer1}}
X-Caller-Role: Customer
Content-Type: application/json

{ "firstName": "Grace", "lastName": "Adeyemi", "email": "grace.adeyemi@example.com", "address": "99 New Road, Bath, BA1 1AA" }

### Adviser 1 reads the audit trail for their customer -> 200
GET {{host}}/api/v1/audit?customerId={{customer1}}
X-Caller-Id: {{adviser1}}
X-Caller-Role: Adviser
